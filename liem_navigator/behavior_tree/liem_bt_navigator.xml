<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="ComputePathToPoseWithRecovery"
                  number_of_retries="1">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1">
          <ComputePathToPose goal="{goal}"
                             planner_id="GridBased_A_Star"
                             path="{path}"
                             server_timeout=""/>
        </RateController>
        <FollowPath controller_id="FollowPath_DWB"
                    path="{path}"
                    goal_checker_id=""
                    server_timeout=""/>
      </PipelineSequence>
      <ClearEntireCostmap name="ClearGlobalCostmap"
                          service_name="global_costmap/clear_entirely_global_costmap"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
